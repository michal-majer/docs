{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "S4Kit",
  "colors": {
    "primary": "#4338ca",
    "light": "#818cf8",
    "dark": "#312e81"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart",
              "contributing"
            ]
          },
          {
            "group": "SDK",
            "pages": [
              "sdk/installation",
              "sdk/authentication",
              "sdk/basic-operations",
              "sdk/querying",
              "sdk/advanced",
              "sdk/error-handling",
              "sdk/cli"
            ]
          },
          {
            "group": "Platform",
            "pages": [
              "platform/overview",
              "platform/systems",
              "platform/instances",
              "platform/services",
              "platform/api-keys",
              "platform/authentication",
              "platform/logs",
              "platform/self-hosting",
              "platform/cloud-foundry"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/architecture",
              "concepts/auth-inheritance",
              "concepts/permissions"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Admin API",
            "pages": [
              "api-reference/introduction"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/michal-majer/s4kit",
          "icon": "github"
        },
        {
          "anchor": "NPM",
          "href": "https://www.npmjs.com/package/s4kit",
          "icon": "npm"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:contact@s4kit.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://staging.app.s4kit.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/michal-majer/s4kit"
    }
  }
}
